flowchart TD
    Prev["📊 Previous minute<br/>5 requests"]
    Cur["📊 Current minute<br/>3 requests<br/>(30% elapsed)"]
    Prev --> Formula
    Cur --> Formula
    Formula["Estimate =<br/>current + previous × overlap%<br/>━━━━━━━━━━<br/>3 + 5 × 0.7 = 6.5<br/>≈ 6 requests"]
